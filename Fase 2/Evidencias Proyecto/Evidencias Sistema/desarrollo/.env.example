# «python preparar.py» crea el .env a partir de este archivo, con claves aleatorias.
# También se puede copiar a mano como .env y reemplazar los valores
MONGO_USER=roommatch_admin
MONGO_PASSWORD=cambiar_esta_clave
# Debe usar el mismo usuario y clave de arriba
MONGO_URI=mongodb://roommatch_admin:cambiar_esta_clave@mongo:27017/?authSource=admin
MONGO_DB=roommatch
# Clave larga y aleatoria para firmar las sesiones
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
# Cuenta de administrador que la API crea al iniciar si no existe
ADMIN_CORREO=admin@roommatch.cl
ADMIN_PASSWORD=cambiar_esta_clave_de_admin
